{
  "name": "happyhome-field",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler d1 migrations apply DB --local && wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
